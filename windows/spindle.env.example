HOST=127.0.0.1
PORT=3590
INGEST_SECRET=CHANGE-ME
STATS_DB_PATH=./data/stats.db

# Use forward slashes on Windows. Point this at the live Navidrome database.
NAVIDROME_DB_PATH=C:/ProgramData/Navidrome/navidrome.db

# Your Navidrome login name. This user's stats load by default.
DEFAULT_USER=
SESSION_GAP_MINUTES=30

# Native Windows bundles serve the built frontend from ./web.
WEB_DIR=./web

# --- Auth (recommended if Spindle is reachable beyond localhost) ---
SPINDLE_PASSWORD_HASH=
SESSION_SECRET=
AUTH_COOKIE_SECURE=false
SESSION_DAYS=30
AUTH_ENABLED=true
TRUST_PROXY=false
SPINDLE_READ_TOKEN=

# --- Cover art + in-app player ---
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=
COVER_CACHE_DIR=./data/covers

# Optional. See docs before enabling if you import timestamped history.
EXCLUDE_BASELINE_WHEN_IMPORTED=false
